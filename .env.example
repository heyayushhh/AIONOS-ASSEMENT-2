# =====================================================================
# Veridian Corp — IT Internal Service Agent Environment Configuration
# =====================================================================

# Database Configuration (Defaults to local SQLite if unspecified)
DATABASE_URL=sqlite:///./helpdesk.db

# Gemini API Key (OPTIONAL)
# If provided, the agent enhances conversational phrasing with Google Gemini.
# If omitted or empty, the application runs 100% offline using the deterministic
# Veridian Corp Policy Engine (KB-01 to KB-10 + Asset Management Policy).
GEMINI_API_KEY=

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Legacy Webhooks (disabled by default)
N8N_CHAT_WEBHOOK_URL=
N8N_CREATE_TICKET_WEBHOOK_URL=
N8N_TICKET_STATUS_WEBHOOK_URL=
